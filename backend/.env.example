# LeafGuard AI - Environment Configuration
# Copy to .env and fill in values

ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Storage
UPLOAD_DIR=uploads
RESULTS_DIR=results
MODELS_DIR=models

# Model
MODEL_VERSION=leafguard-v1.0

# Image Validation
MAX_FILE_SIZE_MB=25
MIN_IMAGE_DIM=64
MAX_IMAGE_DIM=4096
BLUR_THRESHOLD=50.0
BRIGHTNESS_MIN=30.0
BRIGHTNESS_MAX=240.0
CONTRAST_MIN=15.0

# Inference
DEVICE=cpu
CONFIDENCE_HIGH_THRESHOLD=0.85
CONFIDENCE_LOW_THRESHOLD=0.60

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
